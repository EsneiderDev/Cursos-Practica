# Enforce HTTPS for all registry communications (prevents MITM attacks)
strict-ssl=true

# Verify package integrity against checksums on every install
verify-store-integrity=true

# Automatically audit installed packages for known vulnerabilities
audit=true

# Save exact versions to prevent silent upgrades from range specifiers (^, ~)
save-exact=true

# Explicit registry declaration to prevent registry confusion / DNS hijacking
registry=https://registry.npmjs.org/

# Suppress funding messages
fund=false

# Require packages to be published for at least 1440 minutes (24 h) before installation.
# Mitigates supply-chain attacks via freshly published / hijacked packages ("protestware").
# pnpm will refuse to resolve any version younger than this threshold.
minimum-release-age=1440

# Explicitly use pnpm's isolated node_modules (its default, but declared for clarity).
# Each package can only resolve its own declared dependencies — phantom dependencies
# that work in npm/yarn because of hoisting are not visible here.
node-linker=isolated
